diff --git a/tests/framework/utils/k8s_helper.go b/tests/framework/utils/k8s_helper.go
index 2f7d1e7c6..3a6dc1a0f 100644
--- a/tests/framework/utils/k8s_helper.go
+++ b/tests/framework/utils/k8s_helper.go
@@ -144,6 +144,12 @@ func (k8sh *K8sHelper) GetDockerImage(image string) error {
 	if dockercmd == "" {
 		dockercmd = "docker"
 	}
+	// rgw-go: the derived Ceph image is built on the runner and pushed to no
+	// registry, so a pull of it is denied. An image already present needs none.
+	if _, err := k8sh.executor.ExecuteCommandWithOutput(dockercmd, "image", "inspect", image); err == nil {
+		k8slogger.Infof("image %q is present locally, not pulling it", image)
+		return nil
+	}
 	return k8sh.executor.ExecuteCommand(dockercmd, "pull", image)
 }
 
