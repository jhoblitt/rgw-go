+
+// alloc is a new block of n bytes: mmap'd when n is mmapSize, from the Go heap otherwise or when
+// the mmap fails. THROWAWAY (realworld spike, variant FMM).
+func (l *bufLists) alloc(n uint64) *[]byte {
+	if n == l.mmapSize && n > 0 {
+		b, err := syscall.Mmap(-1, 0, int(n), syscall.PROT_READ|syscall.PROT_WRITE, syscall.MAP_PRIVATE|syscall.MAP_ANONYMOUS) //nolint:gosec // n is a chunk size
+		if err == nil {
+			l.mu.Lock()
+			if l.mapped == nil {
+				l.mapped = make(map[unsafe.Pointer]struct{})
+			}
+			l.mapped[unsafe.Pointer(unsafe.SliceData(b))] = struct{}{}
+			l.mu.Unlock()
+			l.mmapBytes.Add(int64(n)) //nolint:gosec // n is a chunk size
+			return &b
+		}
+	}
+	return new(make([]byte, n))
+}
+
+// dropLocked lets p go: munmap'd if the list mapped it, left to the GC otherwise, which it
+// reports. THROWAWAY (realworld spike, variant FMM).
+func (l *bufLists) dropLocked(p *[]byte) (heap bool) {
+	b := (*p)[:cap(*p)]
+	key := unsafe.Pointer(unsafe.SliceData(b))
+	if _, ok := l.mapped[key]; !ok {
+		return true
+	}
+	delete(l.mapped, key)
+	if err := syscall.Munmap(b); err == nil {
+		l.munmapBytes.Add(int64(len(b)))
+	}
+	return false
 }
 
